generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
}

model Company {
  id                  Int     @id @default(autoincrement())
  company_name        String
  slogan              String
  company_location    String
  type                String
  number_of_employees Int
  about               String
  website_url         String?
}
